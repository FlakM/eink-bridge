<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sessionListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sessions"
                android:textSize="26sp"
                android:textColor="#000000"
                android:fontFamily="serif" />

            <Button
                android:id="@+id/btnClearSessions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Clear finished"
                android:textSize="14sp"
                android:textColor="#CC0000"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#333333"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No sessions yet"
            android:textSize="20sp"
            android:textColor="#999999"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Server URL"
                android:textSize="16sp"
                android:inputType="textUri"
                android:padding="8dp" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Connect"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <EditText
                android:id="@+id/metricsInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Pushgateway URL (optional)"
                android:textSize="13sp"
                android:inputType="textUri"
                android:padding="8dp"
                android:textColor="#555555"
                android:textColorHint="#AAAAAA" />

            <Button
                android:id="@+id/metricsBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Save"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Persistent stroke layer -->
    <com.flakm.einkbridge.StrokeView
        android:id="@+id/strokeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Color drawer: sits above toolbar, hidden by default -->
    <LinearLayout
        android:id="@+id/colorDrawer"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="72dp"
        android:layout_marginStart="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone" />

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/penToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <!-- DRAW CONTROLS: hidden in Tag and Move modes -->
        <LinearLayout
            android:id="@+id/drawControls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/strokeSlider"
                android:layout_width="160dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:min="1"
                android:max="20"
                android:progress="5"
                android:thumbTint="#000000"
                android:progressTint="#000000"
                android:progressBackgroundTint="#CCCCCC" />

            <View
                android:layout_width="2dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"
                android:background="#999999" />

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="64dp">
                <Button
                    android:id="@+id/btnPencil"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="60dp"
                    android:layout_height="64dp"
                    android:text="✎"
                    android:textSize="34sp"
                    android:textColor="#000000" />
                <View
                    android:id="@+id/dotPencil"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/indicator_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="64dp">
                <Button
                    android:id="@+id/btnBrush"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="60dp"
                    android:layout_height="64dp"
                    android:text="▓"
                    android:textSize="34sp"
                    android:textColor="#000000" />
                <View
                    android:id="@+id/dotBrush"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/indicator_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="64dp">
                <Button
                    android:id="@+id/btnEraser"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="60dp"
                    android:layout_height="64dp"
                    android:text="⌫"
                    android:textSize="34sp"
                    android:textColor="#000000" />
                <View
                    android:id="@+id/dotEraser"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="3dp"
                    android:background="@drawable/indicator_dot"
                    android:visibility="gone" />
            </FrameLayout>

            <Button
                android:id="@+id/btnColor"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="⬤"
                android:textSize="24sp"
                android:textColor="#000000" />

        </LinearLayout>

        <!-- DIVIDER: between draw controls and mode buttons -->
        <View
            android:layout_width="2dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:background="#CCCCCC" />

        <!-- TAG MODE: draw a lasso gesture to create an annotation group -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="64dp">
            <Button
                android:id="@+id/btnLink"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="60dp"
                android:layout_height="64dp"
                android:text="⊙"
                android:textSize="32sp"
                android:textColor="#000000"
                android:alpha="0.5" />
            <View
                android:id="@+id/dotLink"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/indicator_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- MOVE MODE: tap and drag annotation groups or labels to reposition -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="64dp">
            <Button
                android:id="@+id/btnSelect"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="60dp"
                android:layout_height="64dp"
                android:text="↖"
                android:textSize="32sp"
                android:textColor="#000000"
                android:alpha="0.5" />
            <View
                android:id="@+id/dotSelect"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/indicator_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- CONTEXT BAR: shown when a group is selected in Move mode -->
        <LinearLayout
            android:id="@+id/contextBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="4dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnReOcr"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="↺ Re-OCR"
                android:textSize="15sp"
                android:textColor="#000000"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnRemoveGroup"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="✕ Remove"
                android:textSize="15sp"
                android:textColor="#CC0000"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </LinearLayout>

        <!-- FLEX SPACER -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- ANNOTATIONS TOGGLE: view toggle, right-aligned away from mode buttons -->
        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="64dp">
            <Button
                android:id="@+id/btnAnnotations"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="52dp"
                android:layout_height="64dp"
                android:text="👁"
                android:textSize="28sp"
                android:textColor="#000000"
                android:alpha="0.35" />
            <View
                android:id="@+id/dotAnnotations"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/indicator_dot"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="2dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#999999" />

        <Button
            android:id="@+id/btnUndo"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:text="↩"
            android:textSize="34sp"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnClear"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="56dp"
            android:layout_height="64dp"
            android:text="✕"
            android:textSize="34sp"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnRequestUpdate"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="110dp"
            android:text="↻ Update"
            android:textSize="17sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:minWidth="110dp"
            android:text="✓ Done"
            android:textSize="19sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000" />
    </LinearLayout>

    <!-- Processing overlay: shown while OCR / agent update is in flight -->
    <LinearLayout
        android:id="@+id/processingOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#FFFFFF" />

        <TextView
            android:id="@+id/processingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Processing..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnCancelProcessing"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:minWidth="44dp"
            android:minHeight="44dp" />
    </LinearLayout>

</FrameLayout>
