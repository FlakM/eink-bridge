<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sessionListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sessions"
                android:textSize="26sp"
                android:textColor="#000000"
                android:fontFamily="serif" />

            <Button
                android:id="@+id/btnClearSessions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Clear finished"
                android:textSize="14sp"
                android:textColor="#CC0000"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#333333"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No sessions yet"
            android:textSize="20sp"
            android:textColor="#999999"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Server URL"
                android:textSize="16sp"
                android:inputType="textUri"
                android:padding="8dp" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Connect"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Persistent stroke layer -->
    <com.flakm.einkbridge.StrokeView
        android:id="@+id/strokeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/penToolbar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <SeekBar
            android:id="@+id/strokeSlider"
            android:layout_width="180dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:min="1"
            android:max="20"
            android:progress="5"
            android:thumbTint="#000000"
            android:progressTint="#000000"
            android:progressBackgroundTint="#CCCCCC" />

        <View
            android:layout_width="2dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#999999" />

        <!-- Pencil with active dot -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">
            <Button
                android:id="@+id/btnPencil"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="✎"
                android:textSize="36sp"
                android:textColor="#000000" />
            <View
                android:id="@+id/dotPencil"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/indicator_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Brush with active dot -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">
            <Button
                android:id="@+id/btnBrush"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="▓"
                android:textSize="36sp"
                android:textColor="#000000" />
            <View
                android:id="@+id/dotBrush"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/indicator_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Eraser with active dot -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">
            <Button
                android:id="@+id/btnEraser"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="⌫"
                android:textSize="36sp"
                android:textColor="#000000" />
            <View
                android:id="@+id/dotEraser"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/indicator_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bind with active dot -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">
            <Button
                android:id="@+id/btnLink"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="📎"
                android:textSize="36sp"
                android:textColor="#000000" />
            <View
                android:id="@+id/dotLink"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/indicator_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Annotations toggle with active dot -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">
            <Button
                android:id="@+id/btnAnnotations"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:text="👁"
                android:textSize="34sp"
                android:textColor="#000000"
                android:alpha="0.35" />
            <View
                android:id="@+id/dotAnnotations"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="3dp"
                android:background="@drawable/indicator_dot"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Color picker swatch -->
        <Button
            android:id="@+id/btnColor"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="⬤"
            android:textSize="28sp"
            android:textColor="#000000" />

        <View
            android:layout_width="2dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#999999" />

        <Button
            android:id="@+id/btnUndo"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="↩"
            android:textSize="36sp"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnClear"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:text="✕"
            android:textSize="36sp"
            android:textColor="#000000" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRequestUpdate"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="120dp"
            android:text="↻ Update"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#555555"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:minWidth="120dp"
            android:text="✓ Done"
            android:textSize="20sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#000000" />
    </LinearLayout>

    <!-- Processing overlay: shown while OCR / agent update is in flight -->
    <LinearLayout
        android:id="@+id/processingOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#FFFFFF" />

        <TextView
            android:id="@+id/processingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Processing..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</FrameLayout>
