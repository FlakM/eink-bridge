<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sessionListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sessions"
                android:textSize="26sp"
                android:textColor="#000000"
                android:fontFamily="serif" />

            <Button
                android:id="@+id/btnCleanNotes"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Clean notes"
                android:textSize="14sp"
                android:textColor="#CC0000"
                style="?android:attr/buttonBarButtonStyle" />

        <Button
                android:id="@+id/btnClearSessions"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Clear finished"
                android:textSize="14sp"
                android:textColor="#CC0000"
                style="?android:attr/buttonBarButtonStyle" />
        </LinearLayout>

        <TextView
            android:id="@+id/serverUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#333333"
            android:paddingBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No sessions yet"
            android:textSize="20sp"
            android:textColor="#999999"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp">

            <EditText
                android:id="@+id/serverInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Server URL"
                android:textSize="16sp"
                android:inputType="textUri"
                android:padding="8dp" />

            <Button
                android:id="@+id/connectBtn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Connect"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <EditText
                android:id="@+id/metricsInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Pushgateway URL (optional)"
                android:textSize="13sp"
                android:inputType="textUri"
                android:padding="8dp"
                android:textColor="#555555"
                android:textColorHint="#AAAAAA" />

            <Button
                android:id="@+id/metricsBtn"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Save"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Persistent stroke layer -->
    <com.flakm.einkbridge.StrokeView
        android:id="@+id/strokeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

    <!-- Quiet, non-blocking feedback instead of large system toast banners. -->
    <TextView
        android:id="@+id/routineStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="76dp"
        android:layout_marginEnd="12dp"
        android:maxWidth="260dp"
        android:maxLines="2"
        android:textSize="12sp"
        android:textColor="#555555"
        android:background="#FFFFFF"
        android:padding="4dp"
        android:clickable="false"
        android:focusable="false"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <!-- Popovers: each opens above its own button, which positions it when it is shown -->
    <LinearLayout
        android:id="@+id/sizeDrawer"
        style="@style/Widget.Popover" />

    <LinearLayout
        android:id="@+id/colorDrawer"
        style="@style/Widget.Popover" />

    <!-- Agent progress: a thin line just above the toolbar. No animation (e-ink), and
         only present when the agent reported a step and a total. -->
    <ProgressBar
        android:id="@+id/agentProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/toolbar_height"
        android:max="100"
        android:progress="0"
        android:progressTint="#000000"
        android:progressBackgroundTint="#DDDDDD"
        android:indeterminate="false"
        android:visibility="gone" />

    <!-- Toolbar: tools | modes | (context) | view | spacer | edit | commit -->
    <LinearLayout
        android:id="@+id/penToolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/toolbar_background"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/toolbar_padding"
        android:paddingEnd="@dimen/toolbar_padding"
        android:visibility="gone">

        <!-- TOOLS: hidden in Tag and Move modes -->
        <LinearLayout
            android:id="@+id/drawControls"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout style="@style/Widget.ToolGroup">

                <ImageButton
                    android:id="@+id/btnPencil"
                    style="@style/Widget.ToolButton"
                    android:contentDescription="@string/btnPencil_desc"
                    android:src="@drawable/ic_pencil" />

                <ImageButton
                    android:id="@+id/btnBrush"
                    style="@style/Widget.ToolButton"
                    android:contentDescription="@string/btnBrush_desc"
                    android:src="@drawable/ic_brush" />

                <ImageButton
                    android:id="@+id/btnEraser"
                    style="@style/Widget.ToolButton"
                    android:contentDescription="@string/btnEraser_desc"
                    android:src="@drawable/ic_eraser" />

                <ImageButton
                    android:id="@+id/btnSize"
                    style="@style/Widget.ToolButton"
                    android:contentDescription="@string/btnSize_desc"
                    android:src="@drawable/ic_stroke_width" />

                <ImageButton
                    android:id="@+id/btnColor"
                    style="@style/Widget.ToolButton"
                    android:contentDescription="@string/btnColor_desc"
                    android:src="@drawable/ic_color" />
            </LinearLayout>

            <View style="@style/Widget.ToolbarRule" />
        </LinearLayout>

        <!-- MODES: lasso a group of strokes to text, or move a group -->
        <LinearLayout style="@style/Widget.ToolGroup">

            <ImageButton
                android:id="@+id/btnLink"
                style="@style/Widget.ToolButton"
                android:contentDescription="@string/btnLink_desc"
                android:src="@drawable/ic_lasso" />

            <ImageButton
                android:id="@+id/btnSelect"
                style="@style/Widget.ToolButton"
                android:contentDescription="@string/btnSelect_desc"
                android:src="@drawable/ic_move" />
        </LinearLayout>

        <!-- CONTEXT: shown when a group is selected in Move mode -->
        <LinearLayout
            android:id="@+id/contextBar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <View style="@style/Widget.ToolbarRule" />

            <LinearLayout style="@style/Widget.ToolGroup">

                <ImageButton
                    android:id="@+id/btnReOcr"
                    style="@style/Widget.ToolButton"
                    android:contentDescription="@string/btnReOcr_desc"
                    android:src="@drawable/ic_refresh" />

                <ImageButton
                    android:id="@+id/btnRemoveGroup"
                    style="@style/Widget.ToolButton"
                    android:contentDescription="@string/btnRemoveGroup_desc"
                    android:src="@drawable/ic_delete" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/Widget.ToolbarRule" />

        <!-- VIEW -->
        <ImageButton
            android:id="@+id/btnAnnotations"
            style="@style/Widget.ToolButton"
            android:contentDescription="@string/btnAnnotations_desc"
            android:src="@drawable/ic_visibility" />

        <View
            android:id="@+id/toolbarSpacer"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- EDIT -->
        <LinearLayout style="@style/Widget.ToolGroup">

            <ImageButton
                android:id="@+id/btnUndo"
                style="@style/Widget.ToolButton"
                android:contentDescription="@string/btnUndo_desc"
                android:src="@drawable/ic_undo" />

            <ImageButton
                android:id="@+id/btnClear"
                style="@style/Widget.ToolButton"
                android:contentDescription="@string/btnClear_desc"
                android:src="@drawable/ic_clear" />
        </LinearLayout>

        <View style="@style/Widget.ToolbarRule" />

        <!-- COMMIT -->
        <LinearLayout style="@style/Widget.ToolGroup">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRequestUpdate"
                style="@style/Widget.ActionButton"
                android:text="@string/action_update" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSubmit"
                style="@style/Widget.ActionButton.Primary"
                android:text="@string/action_done" />
        </LinearLayout>
    </LinearLayout>

    <!-- Processing overlay: shown while OCR / agent update is in flight -->
    <LinearLayout
        android:id="@+id/processingOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateTint="#FFFFFF" />

        <TextView
            android:id="@+id/processingStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Processing..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginStart="8dp" />

        <Button
            android:id="@+id/btnCancelProcessing"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:minWidth="44dp"
            android:minHeight="44dp" />
    </LinearLayout>

</FrameLayout>
