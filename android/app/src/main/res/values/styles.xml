<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The pen toolbar. Every button is the same size with the same icon size, so the row
      never shifts; the active tool is the inverted one. No elevation, no ripples: on e-ink
      a shadow is a grey smudge and an animation is a repaint.
-->
    <style name="Widget.ToolButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/tool_button_background</item>
        <item name="android:tint">@color/tool_icon_tint</item>
        <item name="android:padding">18dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <style name="Widget.ActionButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:minWidth">132dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">#000000</item>
        <item name="android:background">@drawable/action_button_background</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:layout_marginStart">6dp</item>
    </style>

    <style name="Widget.ActionButton.Primary">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/action_button_primary_background</item>
        <item name="android:backgroundTint">@null</item>
    </style>
</resources>
