{
  "components": {
    "schemas": {
      "AnnotationGroup": {
        "description": "A group of strokes optionally anchored to document elements",
        "properties": {
          "anchor": {
            "description": "Anchor binding strokes to document elements"
          },
          "color": {
            "description": "Hex color of the annotation stroke (e.g. #CC0000)",
            "type": [
              "string",
              "null"
            ]
          },
          "pressures": {
            "description": "Optional parallel array: per-point 0..1 stylus pressure for each stroke",
            "type": "array"
          },
          "recognized_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "strokes": {
            "description": "Array of strokes, each stroke is an array of [x,y] points",
            "type": "array"
          }
        },
        "type": "object"
      },
      "CreateSessionRequest": {
        "properties": {
          "callback_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/SessionOrigin"
          },
          "schema_version": {
            "type": "integer"
          },
          "starred": {
            "type": "boolean"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "content"
        ],
        "type": "object"
      },
      "CreateSessionResponse": {
        "properties": {
          "id": "<id>",
          "schema_version": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ElementRef": {
        "properties": {
          "section_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tag": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SessionDetailResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionSummaryResponse"
          },
          {
            "properties": {
              "callback_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        ]
      },
      "SessionOrigin": {
        "description": "Metadata about where the session originated (cwd, host, git state).",
        "properties": {
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "git_branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "git_remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "SessionResultResponse": {
        "properties": {
          "annotation_images": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "annotations": {
            "items": {
              "$ref": "#/components/schemas/AnnotationGroup"
            },
            "type": "array"
          },
          "created_at": "<timestamp>",
          "has_annotation": {
            "type": "boolean"
          },
          "id": "<id>",
          "review_duration_seconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "schema_version": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "stroke_data": {
            "description": "Raw pen strokes: {canvas_width, canvas_height, strokes:[[[x,y],...],...]}"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "typed_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": "<timestamp>",
          "verdict": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "SessionSummaryResponse": {
        "properties": {
          "created_at": "<timestamp>",
          "id": "<id>",
          "origin": {
            "$ref": "#/components/schemas/SessionOrigin"
          },
          "schema_version": {
            "type": "integer"
          },
          "starred": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": "<timestamp>"
        },
        "type": "object"
      },
      "SetStarredRequest": {
        "properties": {
          "starred": {
            "type": "boolean"
          }
        },
        "required": [
          "starred"
        ],
        "type": "object"
      },
      "SubmitReviewRequest": {
        "properties": {
          "annotations": {
            "items": {
              "$ref": "#/components/schemas/AnnotationGroup"
            },
            "type": "array"
          },
          "document_version": {
            "description": "Reject feedback from an outdated rendered document",
            "type": "integer"
          },
          "schema_version": {
            "type": "integer"
          },
          "typed_notes": {
            "type": "string"
          },
          "verdict": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "AI-friendly review session API for pushing markdown to the e-ink device and collecting structured review results.",
    "title": "E-Ink Bridge API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Server healthy"
          }
        },
        "summary": "Health check"
      }
    },
    "/api/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenAPI spec"
          }
        },
        "summary": "OpenAPI document"
      }
    },
    "/api/sessions": {
      "get": {
        "parameters": [
          {
            "description": "Filter by session status (Active, Submitted, Cancelled, Expired)",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter to only starred (true) or only unstarred (false) sessions",
            "in": "query",
            "name": "starred",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummaryResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Session summaries (starred sessions sorted first)"
          }
        },
        "summary": "List sessions"
      },
      "post": {
        "description": "Supports either plain text markdown body with optional query params or JSON request body.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            },
            "description": "Session created"
          }
        },
        "summary": "Create session"
      }
    },
    "/api/sessions/{id}": {
      "delete": {
        "responses": {
          "200": {
            "description": "Session cancelled"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Cancel session"
      },
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetailResponse"
                }
              }
            },
            "description": "Session detail"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Get session metadata"
      }
    },
    "/api/sessions/{id}/content": {
      "get": {
        "responses": {
          "200": {
            "description": "content, version, status"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Recover current markdown and version to resume a review without scraping HTML"
      },
      "put": {
        "description": "JSON {content,expected_version?,feedback_id?,consumed_annotations?} or plain markdown. consumed_annotations are zero-based indices of incorporated notes, require matching feedback_id, and resolve to consumed_strokes for native clients. Unacknowledged feedback survives manual edits.",
        "responses": {
          "200": {
            "description": "New version"
          },
          "400": {
            "description": "Invalid feedback ID or annotation index"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Stale version or terminal session"
          }
        },
        "summary": "Rewrite content, optionally acknowledge a feedback request"
      }
    },
    "/api/sessions/{id}/feedback": {
      "get": {
        "responses": {
          "200": {
            "description": "version, pending (annotation_result or null), last_content_update (version_updated or null)"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Recover durable pending feedback and latest content-update instructions"
      }
    },
    "/api/sessions/{id}/reanchor": {
      "post": {
        "description": "Submit previous/current arrays of {i,tag,text}, at most 1000 elements, 150 characters per text. Returns targets parallel to previous: current element indices, or null for missing/ambiguous matches. Client applies actual layout displacement.",
        "responses": {
          "200": {
            "description": "targets array"
          },
          "400": {
            "description": "Invalid or excessive layout"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Resolve previous layout elements to current layout elements by text"
      }
    },
    "/api/sessions/{id}/request_update": {
      "post": {
        "description": "Accepts SubmitReviewRequest. Pending feedback is replayed on WebSocket connection and exposed through GET /feedback until explicitly acknowledged by feedback_id.",
        "responses": {
          "200": {
            "description": "Feedback durably saved; agent response not yet confirmed"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Document changed during recognition or session inactive"
          }
        },
        "summary": "Persist feedback before notifying agents"
      }
    },
    "/api/sessions/{id}/result": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResultResponse"
                }
              }
            },
            "description": "Submitted review result"
          },
          "204": {
            "description": "No change yet"
          },
          "404": {
            "description": "Session not found"
          },
          "410": {
            "description": "Session cancelled or expired"
          }
        },
        "summary": "Poll session result"
      }
    },
    "/api/sessions/{id}/star": {
      "put": {
        "description": "Starred sessions are pinned: they survive purge, expire_stale, and are reloaded from disk in any state.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetStarredRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Star flag updated"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Toggle starred flag on a session"
      }
    },
    "/api/sessions/{id}/submit": {
      "post": {
        "description": "Supports multipart form submissions from the Android client and JSON submissions from AI/native clients.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitReviewRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "annotation": {
                    "format": "binary",
                    "type": "string"
                  },
                  "annotations": {
                    "description": "JSON array of AnnotationGroup objects",
                    "type": "string"
                  },
                  "stroke_data": {
                    "description": "JSON: {canvas_width, canvas_height, strokes:[[[x,y],...],...]}",
                    "type": "string"
                  },
                  "typed_notes": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Review submitted"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Session not active"
          }
        },
        "summary": "Submit review"
      }
    }
  }
}