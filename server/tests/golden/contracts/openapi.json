{
  "components": {
    "schemas": {
      "AnnotationGroup": {
        "description": "A group of strokes optionally anchored to document elements",
        "properties": {
          "anchor": {
            "description": "Anchor binding strokes to document elements"
          },
          "color": {
            "description": "Hex color of the annotation stroke (e.g. #CC0000)",
            "type": [
              "string",
              "null"
            ]
          },
          "pressures": {
            "description": "Optional parallel array: per-point 0..1 stylus pressure for each stroke",
            "type": "array"
          },
          "recognized_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "strokes": {
            "description": "Array of strokes, each stroke is an array of [x,y] points",
            "type": "array"
          }
        },
        "type": "object"
      },
      "CreateSessionRequest": {
        "properties": {
          "callback_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {
            "type": "string"
          },
          "origin": {
            "$ref": "#/components/schemas/SessionOrigin"
          },
          "schema_version": {
            "type": "integer"
          },
          "starred": {
            "type": "boolean"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "content"
        ],
        "type": "object"
      },
      "CreateSessionResponse": {
        "properties": {
          "id": "<id>",
          "schema_version": {
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ElementRef": {
        "properties": {
          "section_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tag": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "SessionDetailResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SessionSummaryResponse"
          },
          {
            "properties": {
              "callback_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "version": {
                "type": "integer"
              }
            },
            "type": "object"
          }
        ]
      },
      "SessionOrigin": {
        "description": "Metadata about where the session originated (cwd, host, git state).",
        "properties": {
          "cwd": {
            "type": [
              "string",
              "null"
            ]
          },
          "git_branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "git_remote": {
            "type": [
              "string",
              "null"
            ]
          },
          "host": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "SessionResultResponse": {
        "properties": {
          "annotation_images": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "annotation_urls": {
            "description": "Fetchable URLs for the annotation images, in the same order as annotation_images",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "annotations": {
            "items": {
              "$ref": "#/components/schemas/AnnotationGroup"
            },
            "type": "array"
          },
          "created_at": "<timestamp>",
          "has_annotation": {
            "type": "boolean"
          },
          "id": "<id>",
          "origin": {
            "$ref": "#/components/schemas/SessionOrigin"
          },
          "review_duration_seconds": {
            "type": [
              "integer",
              "null"
            ]
          },
          "schema_version": {
            "type": "integer"
          },
          "starred": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "stroke_data": {
            "description": "Raw pen strokes: {canvas_width, canvas_height, strokes:[[[x,y],...],...]}"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "typed_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": "<timestamp>",
          "verdict": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "SessionSummaryResponse": {
        "properties": {
          "created_at": "<timestamp>",
          "id": "<id>",
          "origin": {
            "$ref": "#/components/schemas/SessionOrigin"
          },
          "schema_version": {
            "type": "integer"
          },
          "starred": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "tags": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": "<timestamp>"
        },
        "type": "object"
      },
      "SetStarredRequest": {
        "properties": {
          "starred": {
            "type": "boolean"
          }
        },
        "required": [
          "starred"
        ],
        "type": "object"
      },
      "SubmitReviewRequest": {
        "properties": {
          "annotations": {
            "items": {
              "$ref": "#/components/schemas/AnnotationGroup"
            },
            "type": "array"
          },
          "document_version": {
            "description": "Reject feedback from an outdated rendered document",
            "type": "integer"
          },
          "schema_version": {
            "type": "integer"
          },
          "typed_notes": {
            "type": "string"
          },
          "verdict": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "description": "AI-friendly review session API for pushing markdown to the e-ink device and collecting structured review results.",
    "title": "E-Ink Bridge API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Server healthy"
          }
        },
        "summary": "Health check"
      }
    },
    "/api/ocr": {
      "post": {
        "description": "JSON {strokes, pressures?}: strokes are arrays of [x,y] points. Answers the recognised text.",
        "responses": {
          "200": {
            "description": "Recognised text"
          },
          "400": {
            "description": "Too many strokes or points"
          },
          "503": {
            "description": "No OCR engine configured"
          }
        },
        "summary": "Recognise handwriting"
      }
    },
    "/api/openapi.json": {
      "get": {
        "responses": {
          "200": {
            "description": "OpenAPI spec"
          }
        },
        "summary": "OpenAPI document"
      }
    },
    "/api/sessions": {
      "delete": {
        "description": "Removes submitted, cancelled and expired sessions and their files; active and starred ones stay.",
        "responses": {
          "200": {
            "description": "{purged: <count>}"
          }
        },
        "summary": "Purge finished sessions"
      },
      "get": {
        "parameters": [
          {
            "description": "Filter by session status (Active, Submitted, Cancelled, Expired)",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Filter to only starred (true) or only unstarred (false) sessions",
            "in": "query",
            "name": "starred",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SessionSummaryResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Session summaries (starred sessions sorted first)"
          }
        },
        "summary": "List sessions"
      },
      "post": {
        "description": "Supports plain text markdown, a JSON body, or multipart/form-data carrying the images the document displays as repeated `image` parts. A document refers to an attached image as `image/<name>`; the renderer points that at the session's image route.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSessionRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "callback_url": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "image": {
                    "description": "Repeatable. The file name is the name the markdown references; png, jpg, jpeg, webp or gif.",
                    "format": "binary",
                    "type": "string"
                  },
                  "origin": {
                    "description": "JSON SessionOrigin",
                    "type": "string"
                  },
                  "starred": {
                    "description": "true or false",
                    "type": "string"
                  },
                  "tags": {
                    "description": "JSON object of string values",
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            },
            "description": "Session created"
          }
        },
        "summary": "Create session"
      }
    },
    "/api/sessions/{id}": {
      "delete": {
        "responses": {
          "200": {
            "description": "Session cancelled"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Cancel session"
      },
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionDetailResponse"
                }
              }
            },
            "description": "Session detail"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Get session metadata"
      }
    },
    "/api/sessions/{id}/annotation/{index}": {
      "get": {
        "description": "The PNG of the reader's ink; the addresses are in `annotation_urls` of the result.",
        "responses": {
          "200": {
            "description": "image/png"
          },
          "404": {
            "description": "Session or image not found"
          }
        },
        "summary": "A submitted annotation image"
      }
    },
    "/api/sessions/{id}/callback": {
      "put": {
        "description": "JSON {url}. Loopback callers only; the url must be http(s) on this machine unless EINK_CALLBACK_ALLOW_REMOTE=1.",
        "responses": {
          "204": {
            "description": "Registered"
          },
          "400": {
            "description": "Refused url"
          },
          "403": {
            "description": "Not a loopback caller"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Register a webhook for this session's feedback"
      }
    },
    "/api/sessions/{id}/content": {
      "get": {
        "responses": {
          "200": {
            "description": "content, version, status"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Recover current markdown and version to resume a review without scraping HTML"
      },
      "put": {
        "description": "JSON {content,expected_version?,feedback_id?,consumed_annotations?} or plain markdown. consumed_annotations are zero-based indices of incorporated notes, require matching feedback_id, and resolve to consumed_strokes (ink) and consumed_notes (ink-free notes) for native clients. Unacknowledged feedback survives manual edits.",
        "responses": {
          "200": {
            "description": "New version"
          },
          "400": {
            "description": "Invalid feedback ID or annotation index"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Stale version or terminal session"
          }
        },
        "summary": "Rewrite content, optionally acknowledge a feedback request"
      }
    },
    "/api/sessions/{id}/feedback": {
      "get": {
        "responses": {
          "200": {
            "description": "version, pending (annotation_result or null), last_content_update (version_updated or null)"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Recover durable pending feedback and latest content-update instructions"
      }
    },
    "/api/sessions/{id}/image/{name}": {
      "get": {
        "responses": {
          "200": {
            "description": "The image, with its content type, nosniff, and no-store"
          },
          "404": {
            "description": "No such image in this session"
          }
        },
        "summary": "Fetch a picture the document displays"
      },
      "post": {
        "description": "The raw image bytes. The name is one path segment ending in .png, .jpg, .jpeg, .webp or .gif, and the bytes must be that format. The document shows it as `image/<name>`, which the renderer resolves to this route. Only an active session accepts a new image.",
        "parameters": [
          {
            "description": "A plain file name, matching [A-Za-z0-9._-]+ with an image extension",
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "image/gif": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "image/jpeg": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "image/png": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            },
            "image/webp": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Stored; returns {name, url, markdown}"
          },
          "400": {
            "description": "Unusable name or bytes that are not the named format"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Session no longer active"
          }
        },
        "summary": "Attach a picture to the document"
      }
    },
    "/api/sessions/{id}/progress": {
      "post": {
        "description": "JSON {feedback_id, message, step?, of?}. Shown on the tablet in place of 'Waiting for agent' and cleared by the content update that names the same feedback_id.",
        "responses": {
          "204": {
            "description": "Accepted"
          },
          "400": {
            "description": "Empty or over-long message, or a bad step/of"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "feedback_id is not the pending request"
          }
        },
        "summary": "Say what the agent is doing with the reader's feedback"
      }
    },
    "/api/sessions/{id}/reanchor": {
      "post": {
        "description": "Submit previous/current arrays of {i,tag,text}, at most 1000 elements, 150 characters per text. Returns targets parallel to previous: current element indices, or null for missing/ambiguous matches. Client applies actual layout displacement.",
        "responses": {
          "200": {
            "description": "targets array"
          },
          "400": {
            "description": "Invalid or excessive layout"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Resolve previous layout elements to current layout elements by text"
      }
    },
    "/api/sessions/{id}/request_update": {
      "post": {
        "description": "Accepts SubmitReviewRequest. Pending feedback is replayed on WebSocket connection and exposed through GET /feedback until explicitly acknowledged by feedback_id.",
        "responses": {
          "200": {
            "description": "Feedback durably saved; agent response not yet confirmed"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Document changed during recognition or session inactive"
          }
        },
        "summary": "Persist feedback before notifying agents"
      }
    },
    "/api/sessions/{id}/result": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResultResponse"
                }
              }
            },
            "description": "Submitted review result"
          },
          "204": {
            "description": "No change yet"
          },
          "404": {
            "description": "Session not found"
          },
          "410": {
            "description": "Session cancelled or expired"
          }
        },
        "summary": "Poll session result"
      }
    },
    "/api/sessions/{id}/screenshot": {
      "post": {
        "description": "Broadcasts a screenshot_requested message on the session WebSocket. The tablet answers by PUTting a PNG to /api/sessions/{id}/screenshot/{request_id}. A repeat ask while that request is unanswered (up to 20 seconds) reuses its id; an answered or failed request is never reused. `delivered` is false when no tablet (a WebSocket client that connected with ?client=tablet) has the session open, which is worth saying instead of waiting.",
        "responses": {
          "202": {
            "description": "{id, url, delivered}"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Session no longer active"
          }
        },
        "summary": "Ask the tablet to send a picture of what it is showing"
      }
    },
    "/api/sessions/{id}/screenshot/{request_id}": {
      "get": {
        "description": "404 until the tablet has answered, which is what a caller polls for. Served as image/png with nosniff and no-store.",
        "responses": {
          "200": {
            "description": "The PNG"
          },
          "404": {
            "description": "Not sent yet, or no such request"
          },
          "410": {
            "description": "The tablet could not take the picture; the body says why"
          }
        },
        "summary": "Fetch a screenshot the tablet sent"
      },
      "put": {
        "description": "Raw PNG bytes, or `{\"error\": \"...\"}` as application/json when the tablet could not take the picture. The request id must be the one the server is waiting on.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "error": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "image/png": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Stored, or the failure recorded"
          },
          "400": {
            "description": "Empty body, malformed id, or bytes that are not a PNG"
          },
          "404": {
            "description": "Session not found, or no request with that id is being waited for"
          }
        },
        "summary": "Send the screenshot the agent asked for"
      }
    },
    "/api/sessions/{id}/source": {
      "get": {
        "description": "Query ref=<path:line>, context?=<n, max 20>. Read only from the checkout a loopback CLI pushed from.",
        "responses": {
          "200": {
            "description": "The snippet"
          },
          "400": {
            "description": "Bad reference"
          },
          "404": {
            "description": "No checkout, or the file is outside it"
          }
        },
        "summary": "Lines around a path:line reference"
      }
    },
    "/api/sessions/{id}/speech": {
      "post": {
        "description": "Synthesises `text` (at most 2000 characters) with the server's one voice and answers with WAV bytes. Nothing is stored.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "audio/wav"
          },
          "400": {
            "description": "Empty or too long"
          },
          "404": {
            "description": "Session not found"
          },
          "503": {
            "description": "No voice configured"
          }
        },
        "summary": "Read a note aloud"
      }
    },
    "/api/sessions/{id}/star": {
      "put": {
        "description": "Starred sessions are pinned: they survive purge, expire_stale, and are reloaded from disk in any state.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetStarredRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Star flag updated"
          },
          "404": {
            "description": "Session not found"
          }
        },
        "summary": "Toggle starred flag on a session"
      }
    },
    "/api/sessions/{id}/submit": {
      "post": {
        "description": "Supports multipart form submissions from the Android client and JSON submissions from AI/native clients.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitReviewRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "annotation": {
                    "format": "binary",
                    "type": "string"
                  },
                  "annotations": {
                    "description": "JSON array of AnnotationGroup objects",
                    "type": "string"
                  },
                  "stroke_data": {
                    "description": "JSON: {canvas_width, canvas_height, strokes:[[[x,y],...],...]}",
                    "type": "string"
                  },
                  "typed_notes": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Review submitted"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "Session not active"
          }
        },
        "summary": "Submit review"
      }
    },
    "/api/sessions/{id}/voice": {
      "get": {
        "description": "Upgrade to a WebSocket. Binary frames up are 16 kHz mono signed 16-bit PCM; text frames down carry `seq` and are `ready`, `partial`, `final` (raw, text, seconds, confidence, repairs, guarded, audio), `edit`, `done` (the VoiceNote to put under `voice` in an annotation) or `error`. The capture closes itself after 1.5 s of silence following speech, on `{\"type\":\"stop\"}`, and at 300 s or 4 MB. After `final` the client may send `edit` with an instruction (closed verbs apply at once; anything else goes through the cleaner and the content-word guard), `undo`, `done` or `discard`.",
        "responses": {
          "101": {
            "description": "Switching to WebSocket"
          },
          "404": {
            "description": "Session not found"
          },
          "409": {
            "description": "The session is over, or a capture is already open on it"
          },
          "503": {
            "description": "No speech recogniser configured"
          }
        },
        "summary": "Speak a note: a WebSocket the tablet streams audio on"
      }
    },
    "/api/sessions/{id}/voice/{name}": {
      "get": {
        "description": "What the reader said, as 16 kHz mono WAV, kept with the session and removed with it. The name is `<capture>.wav`, the capture id from the `final` frame; anything else is a 404.",
        "responses": {
          "200": {
            "description": "audio/wav, nosniff, no-store"
          },
          "404": {
            "description": "Session or capture not found"
          }
        },
        "summary": "The audio of a spoken note"
      }
    }
  }
}